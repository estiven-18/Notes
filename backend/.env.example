# Configuración del Servidor
PORT=3001
NODE_ENV=development


MONGODB_URI=mongodb+srv://Notes:<password>@clusternotes.1wnrszq.mongodb.net/Notes?appName=ClusterNotes

FRONTEND_URL=http://localhost:5173

# Subida de archivos
# Si usas Cloudinary en Render, define estas variables.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opcional: ruta absoluta para guardar archivos locales cuando no usas Cloudinary.
# En Render solo persistirá si montas un disco persistente en esa ruta.
UPLOADS_DIR=